# Postgres connection (schema in ../schema/schema.sql)
DATABASE_URL=postgresql://spotted:spotted@localhost:5432/spotted
# Gemini key for profile extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Chromium for the JavaScript-rendering check: empty = Playwright's own browser, "off" = skip rendering
CHROMIUM_PATH=
# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
