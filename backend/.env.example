# MongoDB connection; Spotted's collections all start with the prefix (spotted_businesses, spotted_audits, spotted_crawlers)
MONGO_URL=mongodb://user:password@localhost:27017/dbname?authSource=dbname
MONGO_DB=dbname
MONGO_COLLECTION_PREFIX=spotted_
# Gemini key for profile extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Chromium for the JavaScript-rendering check: empty = Playwright's own browser, "off" = skip rendering
CHROMIUM_PATH=
# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# AI runs: OpenRouter key(s), comma separated, for Perplexity and ChatGPT with web search (needs credit)
OPENROUTER_API_KEY=
# Free-run platforms in order: gemini_search, gemini_maps, gemini_memory, perplexity, chatgpt
AI_PLATFORMS=gemini_search,gemini_maps,perplexity,chatgpt
# Where the API runs (recorded with each AI run, since answers can follow server location)
SERVER_REGION=local
# OpenRouter for Perplexity/ChatGPT is research-only: set OPENROUTER_ENABLED=1 to offer them (needs credit)
OPENROUTER_ENABLED=
# Direct ChatGPT (OpenAI Responses API with web search); empty = "coming soon"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_PRICE_IN_PER_M=0.25
# OPENAI_PRICE_OUT_PER_M=2.0
# OPENAI_WEB_SEARCH_PER_1K=10.0
# Full audit (up to 30 questions x 3 runs x every location, search on and off): 1 = allowed (dev/admin; no payment yet)
PAID_AUDITS_ENABLED=
# AI_PAID_RUNS=3
# AI_PAID_MAX_CALLS=1500
# AI_PAID_MAX_USD=15
# AI_PAID_MAX_MINUTES=60
# Free run limits
# AI_FREE_MAX_USD=1
# AI_FREE_PER_BUSINESS_PER_DAY=3
# AI_FREE_PER_IP_PER_DAY=10
# AI_FREE_REUSE_MINUTES=60
# 1 = read the client IP from X-Forwarded-For (only behind your own reverse proxy)
AI_TRUST_FORWARDED_FOR=
# Search step: timeout per Gemini call (seconds)
# SEARCH_CALL_TIMEOUT_S=75
